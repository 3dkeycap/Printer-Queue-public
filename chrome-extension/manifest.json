{
  "manifest_version": 3,
  "name": "Resin Queue — Shopify → Chit Chats",
  "version": "1.3.3",
  "description": "Signale à Resin Queue la commande Shopify ouverte, et propose « Ouvrir sur Chit Chats » avec le bon numéro de commande.",
  "permissions": [
    "storage",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://admin.shopify.com/*",
    "https://*.myshopify.com/*",
    "https://chitchats.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Resin Queue — Chit Chats",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://admin.shopify.com/*",
        "https://*.myshopify.com/admin/*"
      ],
      "js": [
        "pack-panel.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chitchats.com/*"
      ],
      "js": [
        "content-chitchats.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
