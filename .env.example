# ---------------------------------------------------------------------------
# Resin Print Queue - amorçage
#   cp .env.example .env
#
# IMPORTANT : les identifiants des boutiques, les expressions cron et les
# listes UV / commentaires se règlent DANS L'APPLICATION (page « Intégrations »)
# et sont stockés en base. Les variables ci-dessous ne servent qu'à pré-remplir
# une installation neuve.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_PORT=8080
NODE_ENV=production
LOG_LEVEL=info
TZ=America/Toronto

# Fichier SQLite (dans le conteneur : volume « rpq-data »)
DATABASE_PATH=/data/printer-queue.db

# Protection du dashboard. Vide = pas d'authentification.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- Valeurs initiales des réglages ----------------------------------------
# (modifiables ensuite dans la page « Intégrations », sans redéploiement)
SYNC_CRON=*/5 * * * *
SHIPMENT_CRON=*/15 * * * *
SYNC_LOOKBACK_DAYS=14

SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10
SHOPIFY_WEBHOOK_SECRET=

ETSY_SHOP_ID=
ETSY_API_KEY=
ETSY_ACCESS_TOKEN=

CHITCHATS_CLIENT_ID=
CHITCHATS_ACCESS_TOKEN=
CHITCHATS_API_BASE=https://chitchats.com/api/v1
CHITCHATS_WEBHOOK_SECRET=

# Expédier toutes les pièces d'une commande dès que le colis est scanné.
SHIP_ALL_PARTS_ON_SHIPMENT=true
