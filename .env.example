# ---------------------------------------------------------------------------
# Resin Print Queue - configuration
# Copy to .env :  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info
TZ=America/Toronto

# SQLite database file (inside the container it lives on the `pq-data` volume)
DATABASE_PATH=/data/printer-queue.db

# Optional dashboard protection. Leave empty to disable authentication.
# When set, the UI and the API ask for HTTP Basic credentials.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- Integrations ----------------------------------------------------------
# mock  -> no external call, realistic fake orders (perfect for a demo / dev)
# live  -> real Shopify / Etsy / Chit Chats API calls
INTEGRATION_MODE=mock

# Cron expression for the order poller (default: every 5 minutes)
SYNC_CRON=*/5 * * * *
# Cron expression for the Chit Chats shipment reconciliation (safety net for
# missed webhooks, default: every 15 minutes)
SHIPMENT_CRON=*/15 * * * *
# Only look back this many days when polling the marketplaces
SYNC_LOOKBACK_DAYS=14

# --- Shopify (Admin API, private/custom app) -------------------------------
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10
# HMAC secret used to verify Shopify webhooks (optional)
SHOPIFY_WEBHOOK_SECRET=

# --- Etsy (Open API v3) ----------------------------------------------------
ETSY_SHOP_ID=
ETSY_API_KEY=
ETSY_ACCESS_TOKEN=

# --- Chit Chats ------------------------------------------------------------
CHITCHATS_CLIENT_ID=
CHITCHATS_ACCESS_TOKEN=
# https://chitchats.com/api/v1  (production)  |  https://staging.chitchats.com/api/v1
CHITCHATS_API_BASE=https://chitchats.com/api/v1
# Shared secret expected in the `X-Webhook-Secret` header of /api/webhooks/chitchats
CHITCHATS_WEBHOOK_SECRET=

# Mark every remaining part of an order as SHIPPED when Chit Chats ships it.
# false -> only parts that already reached DONE / IN_INVENTORY are shipped,
#          anything still in production is flagged instead.
SHIP_ALL_PARTS_ON_SHIPMENT=true
