# ---------------------------------------------------------------------------
# Resin Print Queue - amorçage
#   cp .env.example .env
#
# IMPORTANT : les identifiants des boutiques, les expressions cron et les
# listes UV / commentaires se règlent DANS L'APPLICATION (page « Intégrations »)
# et sont stockés en base. Les variables ci-dessous ne servent qu'à pré-remplir
# une installation neuve.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_PORT=8080
NODE_ENV=production
LOG_LEVEL=info
TZ=America/Toronto

# Fichier SQLite (dans le conteneur : volume « rpq-data »)
DATABASE_PATH=/data/printer-queue.db

# Protection du dashboard. Vide = pas d'authentification.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# URL publique de ce serveur (avec https, sans slash final). Nécessaire pour
# que le flux OAuth Shopify sache où rediriger le marchand après connexion.
APP_URL=

# --- Mise à jour depuis GitHub (valeurs par défaut : le dashboard, page
# « Intégrations > Mises à jour », est prioritaire) --------------------------
# Dépôt public : aucun token nécessaire. Dépôt privé : token GitHub en LECTURE SEULE (fine-grained token, accès au
# seul dépôt, permission « Contents: Read-only »). Jamais écrit dans .git.
GITHUB_TOKEN=
# owner/dépôt à suivre (vide = le remote « origin » du clone)
GITHUB_REPO=3dkeycap/Printer-Queue-public
# branche à suivre (vide = la branche actuellement extraite)
UPDATE_BRANCH=main
# intervalle de vérification par défaut (secondes) — réglable dans le dashboard
UPDATE_INTERVAL=3600
# nombre de sauvegardes de la base conservées dans le volume
BACKUP_KEEP=10

# --- Valeurs initiales des réglages ----------------------------------------
# (modifiables ensuite dans la page « Intégrations », sans redéploiement)
SYNC_CRON=*/5 * * * *
SHIPMENT_CRON=*/15 * * * *
SYNC_LOOKBACK_DAYS=14

# Shopify (OAuth 2.0) : Client ID / Client secret de ton app, créée dans le
# Partner Dashboard (partners.shopify.com). Le secret sert aussi à vérifier
# les webhooks Shopify. Une fois ces deux valeurs et APP_URL renseignés,
# clique « Connecter via OAuth » dans Intégrations : le domaine de boutique
# et le token d'accès se remplissent automatiquement.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10

ETSY_SHOP_ID=
ETSY_API_KEY=
ETSY_ACCESS_TOKEN=

CHITCHATS_CLIENT_ID=
CHITCHATS_ACCESS_TOKEN=
CHITCHATS_API_BASE=https://chitchats.com/api/v1
CHITCHATS_WEBHOOK_SECRET=

# Expédier toutes les pièces d'une commande dès que le colis est scanné.
SHIP_ALL_PARTS_ON_SHIPMENT=true
