{
  "name": "resin-print-queue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Print queue & inventory manager for a resin 3D printing farm (Shopify / Etsy / Chit Chats).",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/jobs/worker.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "sync:once": "node src/jobs/run-once.js",
    "test": "node --test tests/*.test.js",
    "reset": "node scripts/reset-data.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "compression": "^1.7.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "node-cron": "^3.0.3"
  }
}
